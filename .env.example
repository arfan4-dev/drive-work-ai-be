# Server
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=20

# Default provider when the request does not specify one: mock | gemini | qwen | flux
AI_PROVIDER=mock

# MockProvider tuning (testing only)
# Artificial latency per view so the UI loading state is visible
MOCK_DELAY_MS=400
# Comma-separated view keys that should fail, to test error display: front,rear,frontLeft,rearRight
MOCK_FAIL_VIEWS=

# Google Gemini (implemented). Key from https://aistudio.google.com/apikey - image output needs a PAID tier key.
GEMINI_API_KEY=
# gemini-3.1-flash-image (faster/cheaper) | gemini-3-pro-image (higher quality) | gemini-3.1-flash-lite-image
GEMINI_MODEL=gemini-3.1-flash-image
# Optional: 512 | 1K | 2K | 4K. Leave empty to let the model match the input image size.
GEMINI_IMAGE_SIZE=

# Real providers - NOT implemented yet. Fill in only after verifying current official docs.
QWEN_API_KEY=
QWEN_MODEL=
FLUX_API_KEY=
FLUX_MODEL=
